# =============================================================================
# LinguaAI Backend Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# --- AI Provider Selection ---
# Choose: "openrouter" (default) or "gemini" for direct Google AI API
AI_PROVIDER=openrouter

# --- OpenRouter Settings ---
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Gemini Direct API Settings ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- App Settings ---
SECRET_KEY=your-secret-key-here
TARGET_LANGUAGE=German
NATIVE_LANGUAGE=Polish

# --- Database ---
DISCORD_WEBHOOK_URL=
DATABASE_URL=sqlite:///./lingua_ai.db

# --- Notifications ---
NOTIFY_LESSON_HOUR=8
NOTIFY_REVIEW_HOUR=18

# --- Web Push (VAPID) ---
# Leave empty to disable browser push notifications. To enable, generate a
# keypair once:  python -m backend.scripts.generate_vapid_keys
# then paste the values below. VAPID_SUBJECT identifies the sender (mailto:/https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@linguaai.local

# --- Google Drive Backup ---
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_SECRETS_FILE=backend/gdrive_credentials.json

# --- YouTube ---
YOUTUBE_API_KEY=

# ── Access gate ──────────────────────────────────────────────────────────────
# Empty = no gate (correct for localhost development).
# MUST be set before exposing the app to the internet (cloudflared tunnel, cloud
# deploy). Without it, anyone who learns the URL can read/modify your data and
# spend your OpenRouter credits, because no endpoint except /api/admin/* has any
# authentication. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

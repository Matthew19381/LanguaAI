# =============================================================================
# LinguaAI Backend Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# --- AI Provider Selection ---
# Choose: "openrouter" (default) or "gemini" for direct Google AI API
AI_PROVIDER=openrouter

# --- OpenRouter Settings ---
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Gemini Direct API Settings ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- App Settings ---
SECRET_KEY=your-secret-key-here
TARGET_LANGUAGE=German
NATIVE_LANGUAGE=Polish

# --- Database ---
DISCORD_WEBHOOK_URL=
DATABASE_URL=sqlite:///./lingua_ai.db

# --- Notifications ---
NOTIFY_LESSON_HOUR=8
NOTIFY_REVIEW_HOUR=18

# --- Web Push (VAPID) ---
# Leave empty to disable browser push notifications. To enable, generate a
# keypair once:  python -m backend.scripts.generate_vapid_keys
# then paste the values below. VAPID_SUBJECT identifies the sender (mailto:/https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@linguaai.local

# --- Google Drive Backup ---
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_SECRETS_FILE=backend/gdrive_credentials.json

# --- YouTube ---
YOUTUBE_API_KEY=

# ── Access gate ──────────────────────────────────────────────────────────────
# Empty = no gate (correct for localhost development).
# MUST be set before exposing the app to the internet (cloudflared tunnel, cloud
# deploy). Without it, anyone who learns the URL can read/modify your data and
# spend your OpenRouter credits, because no endpoint except /api/admin/* has any
# authentication. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# ── System Główny (hub) ──────────────────────────────────────────────────────
# Finished lessons tick "LinguaAI: lekcja dnia" in the hub's day plan.
# The key is written here by System-Glowny/backend/scripts/provision_module_keys.py
# (same value as lingua-ai=... in the hub's MODULE_KEYS). Empty = not sent.
SYSTEM_GLOWNY_URL=http://127.0.0.1:8000
SYSTEM_GLOWNY_MODULE_KEY=

# A7: optional LanguageTool server for the automatic check of lessons
# (read from the root .env like the other app settings). Empty = off.
# Local server: http://localhost:8081/v2   Public API (sends the lesson's German
# sentences to languagetool.org): https://api.languagetool.org/v2
LANGUAGETOOL_URL=

# A6: faster-whisper size for the pronunciation trainer (tiny, base, small, medium).
# Choose it on the /asr-pomiar page, which measures each size on your own voice
# (read from the root .env like the other app settings).
WHISPER_MODEL=tiny

# A10: prepare the next lesson in the background after a lesson is completed
# (and once at start-up), so the lesson page does not wait. At most one lesson ahead.
PREPARE_NEXT_LESSON=true
